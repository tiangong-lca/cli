{
  "name": "@tiangong-lca/cli",
  "version": "0.1.16",
  "description": "Unified TianGong LCA CLI with direct REST adapters and low-entropy command surface.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tiangong-lca/cli.git"
  },
  "homepage": "https://github.com/tiangong-lca/cli#readme",
  "bugs": {
    "url": "https://github.com/tiangong-lca/cli/issues"
  },
  "packageManager": "pnpm@11.24.0",
  "type": "module",
  "bin": {
    "tiangong-lca": "./bin/tiangong-lca.js"
  },
  "exports": {
    "./bin/tiangong-lca.js": "./bin/tiangong-lca.js",
    "./auth-identity-receipt": {
      "types": "./dist/src/auth-identity-receipt.d.ts",
      "import": "./dist/src/auth-identity-receipt.js"
    },
    "./command-spec": {
      "types": "./dist/src/command-spec.d.ts",
      "import": "./dist/src/command-spec.js"
    },
    "./runtime": {
      "types": "./dist/src/runtime.d.ts",
      "import": "./dist/src/runtime.js"
    },
    "./batch": {
      "types": "./dist/src/batch.d.ts",
      "import": "./dist/src/batch.js"
    }
  },
  "files": [
    "assets/",
    "bin/",
    "dist/src/",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "scripts": {
    "start": "pnpm build && node ./bin/tiangong-lca.js",
    "dev": "pnpm exec tsx watch src/main.ts",
    "typecheck": "pnpm exec tsc --noEmit",
    "tsc": "pnpm typecheck",
    "lint": "pnpm lint:oxlint && pnpm lint:prettier && pnpm lint:coverage-guards && pnpm lint:data-api-consumers && pnpm typecheck",
    "lint-staged": "pnpm exec lint-staged",
    "lint:coverage-guards": "node ./scripts/assert-no-coverage-ignore.cjs",
    "lint:data-api-consumers": "pnpm exec tsx ./scripts/scan-data-api-consumers.ts",
    "lint:oxlint": "pnpm exec oxlint --type-aware --format=stylish --deny-warnings ./src ./test ./scripts ./bin",
    "lint:prettier": "pnpm exec prettier --check \"{src,test,docs,scripts,bin}/**/*.{js,cjs,mjs,jsx,tsx,ts,md,json}\" \"*.{js,cjs,mjs,jsx,tsx,ts,md,json}\"",
    "prettier": "pnpm exec prettier --write \"{src,test,docs,scripts,bin}/**/*.{js,cjs,mjs,jsx,tsx,ts,md,json}\" \"*.{js,cjs,mjs,jsx,tsx,ts,md,json}\"",
    "prebuild": "pnpm clean",
    "build": "pnpm exec tsc -p tsconfig.build.json",
    "prepack": "pnpm build",
    "prepublishOnly": "pnpm prepush:gate",
    "test": "pnpm build && node --import tsx --test",
    "test:package": "node --test test/toolchain-contract.test.mjs",
    "test:coverage": "pnpm build && node ./scripts/run-test-coverage.cjs",
    "test:coverage:assert-full": "node ./dist/scripts/assert-full-coverage.js",
    "peers:check": "pnpm peers check",
    "prepush:gate": "pnpm lint && pnpm peers:check && pnpm test:package && pnpm test:coverage && pnpm test:coverage:assert-full",
    "release:check-tag": "node ./scripts/ci/check-release-tag.cjs cli",
    "release:assert-unpublished": "node ./scripts/ci/release-version.cjs assert-unpublished",
    "release:verify-published": "node ./scripts/ci/verify-published-release.cjs",
    "clean": "node --eval \"import('node:fs').then(({ rmSync }) => rmSync('dist', { recursive: true, force: true }))\"",
    "live:oauth": "node --import tsx ./scripts/live/oauth-case.ts"
  },
  "lint-staged": {
    "**/*.{js,jsx,ts,tsx,cjs,mjs}": "oxlint --type-aware --format=stylish --deny-warnings",
    "**/*.{js,cjs,mjs,jsx,tsx,ts,md,json}": [
      "prettier --write"
    ]
  },
  "engines": {
    "node": ">=24.19.0 <25",
    "pnpm": "11.24.0"
  },
  "keywords": [
    "tiangong-lca",
    "lca",
    "cli",
    "rest"
  ],
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^24.13.3",
    "c8": "^12.0.0",
    "lint-staged": "^17.4.1",
    "oxlint": "^1.80.0",
    "oxlint-tsgolint": "^7.0.2001",
    "playwright": "1.62.1",
    "prettier": "3.9.6",
    "sigstore": "5.0.0",
    "tsx": "^4.23.13",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.112.4",
    "@tiangong-lca/tidas-sdk": "0.2.0"
  }
}
