# Canonical TianGong LCA CLI environment keys.
# Grouped by support level so maintainers can tell which keys are part of the
# public command surface and which are only internal/preparatory module hooks.

# Public: authenticated API / Edge Function access for implemented read/write
# commands. Official Production needs no .env: run `tiangong-lca auth login`.
# The CLI owns its public Production URL/key/client/callback as one profile.
# Leave the public fields blank to use it. For Dev/self-hosted/custom clients,
# supply the complete matching URL + publishable key + registered public client
# tuple; partial overrides never inherit Production values. Register the exact
# loopback callback (default http://127.0.0.1:49191/oauth/callback).
# Authorization Code + S256 PKCE yields a private,
# locally cached rotating session whose access token is used for runtime requests.
# No extra generic
# `SUPABASE_URL` / `SUPABASE_KEY` shell wrapper env is needed.
# LCI/LCIA data-release management uses this same user session; the account must
# have the server-side `data_product_manager` role. Never add a service-role key.
# Accepted values for `TIANGONG_LCA_API_BASE_URL`:
# - https://<project>.supabase.co
# - https://<project>.supabase.co/functions/v1
# - https://<project>.supabase.co/rest/v1

TIANGONG_LCA_API_BASE_URL=
TIANGONG_LCA_REGION=us-east-1
TIANGONG_LCA_SUPABASE_PUBLISHABLE_KEY=
TIANGONG_LCA_AUTH_MODE=
TIANGONG_LCA_OAUTH_CLIENT_ID=
TIANGONG_LCA_OAUTH_REDIRECT_URI=
TIANGONG_LCA_SESSION_FILE=
TIANGONG_LCA_DISABLE_SESSION_CACHE=false
TIANGONG_LCA_FORCE_REAUTH=false
# Versioned Data API schema contract.
TIANGONG_LCA_DATA_API_PROFILE=api-contract-v1

# Headless alternative: inject one short-lived actor token through an approved
# secret boundary. It is verified online, kept only in memory, and never refreshed.
# Set AUTH_MODE=access-token and explicitly supply API_BASE_URL and
# SUPABASE_PUBLISHABLE_KEY too; a token alone must not select Production.
TIANGONG_LCA_ACCESS_TOKEN=

# Internal/preparatory: currently no public `tiangong-lca` command requires these
# keys, but the repo already contains helper modules that normalize them.
# Keep them documented here so the checked-in env surface matches the codebase.

TIANGONG_LCA_KB_SEARCH_API_BASE_URL=
TIANGONG_LCA_KB_SEARCH_API_KEY=
TIANGONG_LCA_KB_SEARCH_REGION=us-east-1

TIANGONG_LCA_UNSTRUCTURED_API_BASE_URL=
TIANGONG_LCA_UNSTRUCTURED_API_KEY=
TIANGONG_LCA_UNSTRUCTURED_PROVIDER=
TIANGONG_LCA_UNSTRUCTURED_MODEL=
TIANGONG_LCA_UNSTRUCTURED_CHUNK_TYPE=false
TIANGONG_LCA_UNSTRUCTURED_RETURN_TXT=true

# Internal/test-only: quality harness toggles. Public `tiangong-lca` commands do not
# read these values, but the repo scripts already normalize them.

TIANGONG_LCA_COVERAGE=0

# Intentionally absent:
# - `SUPABASE_URL` / `SUPABASE_KEY`
#   The public env contract stays under `TIANGONG_LCA_API_*`; the CLI derives
#   the native `@supabase/supabase-js` client from those keys.
# - `TIANGONG_LCA_TIDAS_SDK_DIR`
#   The CLI now loads `@tiangong-lca/tidas-sdk` directly from package
#   dependencies instead of resolving a sibling checkout or CI-injected dist.

# Public optional QA-only: ignore this block unless `tiangong-lca qa process`
# or `tiangong-lca qa flow` is called with `--enable-llm`.
# When enabled, point `TIANGONG_LCA_REVIEW_LLM_BASE_URL` at an
# OpenAI-compatible Responses API base URL. The CLI will call `<base_url>/responses`.

TIANGONG_LCA_REVIEW_LLM_BASE_URL=
TIANGONG_LCA_REVIEW_LLM_API_KEY=
TIANGONG_LCA_REVIEW_LLM_MODEL=

# Study owner-artifact development candidates only. Explicit loopback task fixtures
# additionally require the exact independently supplied manifest/archive digest.
# These flags cannot admit a worktree candidate to the Production profile.
# TIANGONG_LCA_STUDY_CONTRACT_CANDIDATE_SHA256=
# TIANGONG_LCA_STUDY_REPORT_CONTRACT_CANDIDATE_SHA256=
# TIANGONG_LCA_STUDY_RENDERER_CANDIDATE_SHA256=
